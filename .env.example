# ---------------------------------------------------------------
# RDH Tekstil — ortam değişkenleri
# Bu dosyayı .env.local olarak kopyalayın. Gerçek değerleri commit etmeyin.
# NEXT_PUBLIC_ ön ekli değişkenler tarayıcıya gider; gizli anahtar içermemelidir.
# ---------------------------------------------------------------

# Sitenin kanonik adresi (canonical, hreflang, sitemap, OG URL'leri için).
# Sonunda "/" olmadan yazın.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Tag Manager container ID (ör. GTM-XXXXXXX).
# Boş bırakılırsa GTM hiç yüklenmez. GA4, GTM içinden yapılandırılır.
# GTM yalnızca kullanıcı çerez onayı verdikten sonra yüklenir.
NEXT_PUBLIC_GTM_ID=

# Arama motoru indekslemesini kapatmak için (staging ortamları) "false" yapın.
NEXT_PUBLIC_ALLOW_INDEXING=true

# --- Faz 2'de eklenecek (Supabase, bot koruması vb.) ---
