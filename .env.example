# ---------------------------------------------------------------
# RDH Tekstil — ortam değişkenleri
# Bu dosyayı .env.local olarak kopyalayın. Gerçek değerleri commit etmeyin.
# NEXT_PUBLIC_ ön ekli değişkenler tarayıcıya gider; gizli anahtar içermemelidir.
# ---------------------------------------------------------------

# Sitenin kanonik adresi (canonical, hreflang, sitemap, OG URL'leri için).
# Sonunda "/" olmadan yazın.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Tag Manager container ID (ör. GTM-XXXXXXX).
# Boş bırakılırsa GTM hiç yüklenmez. GA4, GTM içinden yapılandırılır.
# GTM yalnızca kullanıcı çerez onayı verdikten sonra yüklenir.
NEXT_PUBLIC_GTM_ID=

# Arama motoru indekslemesini kapatmak için (staging ortamları) "false" yapın.
NEXT_PUBLIC_ALLOW_INDEXING=true

# --- Supabase (Faz 2) ---
# Yerel: `npx supabase start` sonrası `npx supabase status` çıktısından alın.
# Uzak: proje Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnızca sunucu — asla NEXT_PUBLIC_ yapmayın.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin seed (scripts/seed-admin.mjs) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=RDH Admin

# --- Cloudflare Turnstile (opsiyonel şimdilik) ---
# Bot/spam koruması için. Boşsa honeypot + rate limit kullanılır.
# İleride eklemek için: https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Upload limitleri (opsiyonel) ---
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_FILES=10
UPLOAD_SCAN_ENABLED=false
# Raster (PNG/JPEG/WebP) yüklemeleri WebP'ye sıkıştırır. PDF/SVG etkilenmez. Kapatmak: false
UPLOAD_OPTIMIZE=true

# --- Saklama süresi job (varsayılan kapalı) ---
RETENTION_ENABLED=false
RETENTION_DAYS=0
